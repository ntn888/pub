// Chapter dependency graph for the MSPM0G3507 DriverLib Guide.
//
// Source of truth: outline.md, the "Depends on" fields of each chapter entry.
// An edge A -> B means "A depends on B". Chapters in the un-skippable trunk
// (per chapters/00-front-matter.md) are filled green.
//
// Render: make -C figures  (or: dot -Tsvg 00-dependency-map.dot -o 00-dependency-map.svg)

digraph deps {
    rankdir=TB;
    bgcolor="white";
    graph [fontname="Helvetica", fontsize=11, nodesep=0.30, ranksep=0.45,
           labelloc="t", label="MSPM0G3507 DriverLib Guide — chapter dependencies"];
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9,
          fillcolor="#eef2f7", color="#5b6b7c", margin="0.10,0.05"];
    edge [color="#9aa5b1", arrowsize=0.6, penwidth=0.8];

    // Trunk chapters (cannot be skipped on the linear path)
    node [fillcolor="#d7e8c9", color="#4e7a35"];
    c1  [label="1  board, SDK, loop"];
    c2  [label="2  what runs"];
    c4  [label="4  DriverLib lifecycle"];
    c5  [label="5  clocks / SYSCTL"];
    c6  [label="6  interrupts / NVIC"];
    c9  [label="9  DMA"];

    // Everything else
    node [fillcolor="#eef2f7", color="#5b6b7c"];
    fm  [label="Front matter", fillcolor="#f3e9d2", color="#a98a3f"];
    c3  [label="3  SysConfig"];
    c7  [label="7  GPIO / IOMUX"];
    c8  [label="8  event fabric"];
    c10 [label="10  time bases"];
    c11 [label="11  PWM / capture"];
    c12 [label="12  UART"];
    c13 [label="13  I2C"];
    c14 [label="14  SPI"];
    c15 [label="15  UNICOMM"];
    c16 [label="16  ADC12 / VREF"];
    c17 [label="17  OPA/GPAMP/COMP/DAC12"];
    c18 [label="18  FLASHCTL / EEPROM"];
    c19 [label="19  watchdogs"];
    c20 [label="20  RTC / LFSS"];
    c21 [label="21  low power"];
    c22 [label="22  TRNG / AES"];
    c23 [label="23  MATHACL / IQmath"];
    c24 [label="24  CAN-FD"];
    c25 [label="25  boot paths"];
    c26 [label="26  capstone: ADC→UART"];

    // Part I
    c1 -> fm;
    c2 -> c1;
    c3 -> c2;
    c4 -> c3;
    // Part II
    c5 -> c4;
    c6 -> c4;
    c7 -> c6;
    c8 -> c7;
    c9 -> c6;
    // Part III
    c10 -> c5; c10 -> c6; c10 -> c8;
    c11 -> c10;
    // Part IV
    c12 -> c5; c12 -> c6; c12 -> c9;
    c13 -> c6; c13 -> c9;
    c14 -> c6; c14 -> c9;
    c15 -> c12; c15 -> c13; c15 -> c14;
    // Part V
    c16 -> c5; c16 -> c8; c16 -> c9;
    c17 -> c16;
    // Part VI
    c18 -> c2;
    c19 -> c5; c19 -> c6;
    c20 -> c5;
    c21 -> c5; c21 -> c10; c21 -> c12; c21 -> c20;
    // Part VII
    c22 -> c9; c22 -> c18;
    c23 -> c5;
    c24 -> c5; c24 -> c6; c24 -> c9;
    // Part VIII
    c25 -> c2; c25 -> c18;
    c26 -> c9; c26 -> c12; c26 -> c16;
}
